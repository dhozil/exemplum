# Copy to .env and adjust if you deploy somewhere else.
# .env is git-ignored; this file is not, so a fresh clone can `cp` it and run.
#
# These are the public addresses of the project's own StudioNet deployment.

# localnet | studionet | testnetAsimov | testnetBradbury
VITE_GENLAYER_NETWORK=studionet

VITE_NOTARY_ADDRESS=0x1DE6751acf789FA1F09e0F1E78dE12f1db3E5256
VITE_SETTLEMENT_ADDRESS=0x3cEBfEf9075052b4de0897B2350595F5c8b1FA61

# Optional. RPC falls back to the network definition in genlayer-js.
#VITE_GENLAYER_RPC=https://studio.genlayer.com/api

# Set explicitly, and do not rely on the genlayer-js default: its studionet entry
# is https://genlayer-explorer.vercel.app, which answers 503 on every path, so
# explorer links would be dead on arrival while looking correct.
VITE_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com

# Optional. Enables the "development account" option in the header, which signs
# with this key instead of a browser wallet. For local demos and CI only - never
# set this for a deployment that holds real funds.
#VITE_DEV_ACCOUNT_KEY=0x...
